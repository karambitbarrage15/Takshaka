# ==============================================================================
# LLD Practice Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local to configure your local AI evaluation providers.
# DO NOT commit .env.local or real secrets to version control.
# ==============================================================================

# Google Gemini API Key (Recommended default: gemini-1.5-flash)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative: gpt-4o-mini)
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
